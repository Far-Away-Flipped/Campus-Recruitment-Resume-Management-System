# ============================================================
# 遨天科技 校园招聘简历管理系统 - Docker 部署环境变量
# 用法：复制为项目根目录 .env（.env 已被 .gitignore 排除，不会提交）：
#   cp .env.example .env
# 生产部署务必修改下方所有「CHANGE_ME / ChangeMe」占位值！
# ============================================================

# ---- MySQL root 密码（必填！空值/缺失会导致 docker compose 拒绝启动）----
# 仅在数据卷首次初始化时写入；之后修改不会影响已存在的库。
MYSQL_ROOT_PASSWORD=

# ---- JWT 签名密钥（必填！生产环境务必替换为足够随机的长串）----
# 可用 openssl rand -base64 48 生成
JWT_ADMIN_SECRET=
JWT_PORTAL_SECRET=

# ---- 对外暴露端口 ----
PORTAL_PORT=80          # 学生门户（公网/内网可访问；宿主 80 被占用时改为其他值）
ADMIN_PORT=8081         # HR 管理后台（仅内网访问，勿直接暴露公网）

# ---- 文件存储（容器内路径，可自定义）----
# FILE_UPLOAD_ROOT：后端上传根目录（简历/头像/文档转换产物）。容器内默认 /data，
#   对应宿主的 ./deploy/data 挂载；改它需同步改上面各配置项，勿用相对路径。
# LIBREOFFICE_PATH：LibreOffice 可执行文件（可选，后台 BrandConfig 可覆盖）。
FILE_UPLOAD_ROOT=/data
LIBREOFFICE_PATH=/usr/bin/soffice

# ---- 镜像构建参数 ----
# npm 镜像源（国内加速，海外主机可改回官方源）
NPM_REGISTRY=https://registry.npmmirror.com
# 是否在后端镜像中安装 LibreOffice（Word/DOCX→PDF 简历预览）。
# 置 false 可显著减小镜像体积，代价是文档预览功能不可用。
WITH_LIBREOFFICE=true

# ---- 阿里云短信（可选，默认 mock）----
# 甲方完成阿里云实名认证 + 签名 + 验证码模板报备后：
#   1. 阿里云控制台创建 RAM AccessKey（仅授予 AliyunDysmsFullAccess 或最小短信权限）
#   2. 报备验证码模板（模板变量用 ${code}），记录模板 CODE（如 SMS_123456789）
#   3. 下方 SMS_PROVIDER 改 aliyun 并填 AK 与模板码
#   4. docker compose up -d --build backend 生效
# 未报备期间保持 mock：验证码打后端日志，注册/重置流程可正常联调。
SMS_PROVIDER=mock
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_TEMPLATE_CODE=

# ---- 邮箱验证码 SMTP（可选，默认 mock：验证码打后端日志）----
# 当前注册/重置密码的主验证通道。配置后即真发验证码邮件，例（QQ邮箱）：
#   1. QQ邮箱 → 设置 → 账号 → 开启 SMTP 服务，生成授权码
#   2. 下方 MAIL_PROVIDER 改 smtp，MAIL_HOST=smtp.qq.com，MAIL_PORT=465，
#      MAIL_USERNAME=你的QQ邮箱，MAIL_PASSWORD=授权码（不是QQ密码）
#   3. docker compose up -d --build backend 生效
MAIL_PROVIDER=mock
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
