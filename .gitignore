# ==================== 构建产物 ====================
target/
dist/
node_modules/
*.class
*.jar
!code/**/lib/*.jar

# ==================== 运行日志 ====================
logs/
*.log

# ==================== IDE / 工具运行时状态 ====================
.vscode/
.gstack/
.idea/

# ==================== 环境变量与本地配置 ====================
.env
.env.local
.env.*.local

# ==================== 敏感信息 / 凭证 ====================
登录信息.txt
**/student_token.txt
**/*token*.txt

# ==================== 本地工具安装包（不属于项目源码） ====================
下载/

# ==================== 第三方网页存档 ====================
官网/

# ==================== 测试脚本、测试报告、测试中间产物 ====================
# 顶层散落的一次性诊断/攻击测试脚本（已归集到 工具脚本/ 目录，整体不纳入版本库）
工具脚本/
code/recruit-backend/test_*.py
code/recruit-backend/test_*.sh
code/recruit-backend/test_*.ps1
code/recruit-backend/*.txt
code/recruit-backend/*.pdf

# 独立的”测试/”目录（测试方案文档、脚本、测试产物混杂，整体不纳入版本库）
测试/

# ==================== 可疑/敏感测试残留 ====================
# （此段保留以防未来再次产生同类文件，当前已清理干净）
*adfile.exe
fake_test.pdf
tmp_fake_mz.pdf
captcha_test.png

# ==================== 无用空文件 ====================
# （此段保留以防未来再次产生，当前已清理干净）

# ==================== 运维脚本运行时 PID 文件 ====================
运维脚本/.runtime/

# ==================== 编排器运行时产物 ====================
outputs/

# ==================== Docker 部署运行数据 ====================
# 上传附件/简历数据与容器运行时产物不入版本库
deploy/data/
deploy/mysql-data/

# ==================== Agent 编排运行时产生的中间过程日志 ====================
# 执行编排器（execution-orchestrator）等多智能体协作过程中自动写入的进度追踪文件，
# 是中间状态而非设计资产，正式方案文档（设计/*.md）不受此影响。
设计/执行进度/
